{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "funnel-analytics-journey-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "workers_dev": false,
  "env": {
    "local": {
      "name": "funnel-analytics-journey-worker-local",
      "vars": {
        "JOURNEY_WORKER_ENV": "local",
        "JOURNEY_INACTIVITY_WINDOW_SECONDS": "2592000",
      },
      "queues": {
        "producers": [
          {
            "binding": "JOURNEYS_DLQ",
            "queue": "funnel-analytics-journeys-dlq-local",
          },
          {
            "binding": "FUNNELS_QUEUE",
            "queue": "funnel-analytics-funnels-local",
          },
          {
            "binding": "COMMERCE_QUEUE",
            "queue": "funnel-analytics-commerce-local",
          },
        ],
        "consumers": [
          {
            "queue": "funnel-analytics-journeys-local",
            "max_batch_size": 5,
            "max_batch_timeout": 1,
            "max_retries": 3,
            "max_concurrency": 1,
            "dead_letter_queue": "funnel-analytics-journeys-dlq-local",
          },
        ],
      },
    },
    "preview": {
      "name": "funnel-analytics-journey-worker-preview",
      "vars": {
        "JOURNEY_WORKER_ENV": "preview",
        "JOURNEY_INACTIVITY_WINDOW_SECONDS": "2592000",
      },
      "queues": {
        "producers": [
          {
            "binding": "JOURNEYS_DLQ",
            "queue": "funnel-analytics-journeys-dlq-preview",
          },
          {
            "binding": "FUNNELS_QUEUE",
            "queue": "funnel-analytics-funnels-preview",
          },
          {
            "binding": "COMMERCE_QUEUE",
            "queue": "funnel-analytics-commerce-preview",
          },
        ],
        "consumers": [
          {
            "queue": "funnel-analytics-journeys-preview",
            "max_batch_size": 5,
            "max_batch_timeout": 1,
            "max_retries": 3,
            "max_concurrency": 1,
            "dead_letter_queue": "funnel-analytics-journeys-dlq-preview",
          },
        ],
      },
    },
    "production": {
      "name": "funnel-analytics-journey-worker-production",
      "vars": {
        "JOURNEY_WORKER_ENV": "production",
        "JOURNEY_INACTIVITY_WINDOW_SECONDS": "2592000",
      },
      "queues": {
        "producers": [
          {
            "binding": "JOURNEYS_DLQ",
            "queue": "funnel-analytics-journeys-dlq-production",
          },
          {
            "binding": "FUNNELS_QUEUE",
            "queue": "funnel-analytics-funnels-production",
          },
          {
            "binding": "COMMERCE_QUEUE",
            "queue": "funnel-analytics-commerce-production",
          },
        ],
        "consumers": [
          {
            "queue": "funnel-analytics-journeys-production",
            "max_batch_size": 5,
            "max_batch_timeout": 1,
            "max_retries": 3,
            "max_concurrency": 1,
            "dead_letter_queue": "funnel-analytics-journeys-dlq-production",
          },
        ],
      },
    },
  },
}
