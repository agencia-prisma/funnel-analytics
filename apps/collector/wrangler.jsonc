{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "funnel-analytics-collector",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "workers_dev": true,
  "vars": {
    "COLLECTOR_ENV": "local",
  },
  "queues": {
    "producers": [
      {
        "binding": "EVENTS_QUEUE",
        "queue": "funnel-analytics-events-local",
      },
      {
        "binding": "IDENTITY_QUEUE",
        "queue": "funnel-analytics-identity-local",
      },
    ],
    "consumers": [
      {
        "queue": "funnel-analytics-events-local",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
      },
    ],
  },
  "ratelimits": [
    {
      "name": "EVENTS_RATE_LIMITER",
      "namespace_id": "4001",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
    {
      "name": "IDENTITY_RATE_LIMITER",
      "namespace_id": "4011",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
  "env": {
    "preview": {
      "name": "funnel-analytics-collector-preview",
      "vars": {
        "COLLECTOR_ENV": "preview",
      },
      "queues": {
        "producers": [
          {
            "binding": "EVENTS_QUEUE",
            "queue": "funnel-analytics-events-preview",
          },
          {
            "binding": "IDENTITY_QUEUE",
            "queue": "funnel-analytics-identity-preview",
          },
        ],
      },
      "ratelimits": [
        {
          "name": "EVENTS_RATE_LIMITER",
          "namespace_id": "4002",
          "simple": {
            "limit": 120,
            "period": 60,
          },
        },
        {
          "name": "IDENTITY_RATE_LIMITER",
          "namespace_id": "4012",
          "simple": {
            "limit": 30,
            "period": 60,
          },
        },
      ],
    },
    "production": {
      "name": "funnel-analytics-collector-production",
      "workers_dev": true,
      "vars": {
        "COLLECTOR_ENV": "production",
        "SUPABASE_URL": "https://efkqeqaispyppxnjlobi.supabase.co",
      },
      "queues": {
        "producers": [
          {
            "binding": "EVENTS_QUEUE",
            "queue": "funnel-analytics-events-production",
          },
          {
            "binding": "IDENTITY_QUEUE",
            "queue": "funnel-analytics-identity-production",
          },
        ],
      },
      "ratelimits": [
        {
          "name": "EVENTS_RATE_LIMITER",
          "namespace_id": "4003",
          "simple": {
            "limit": 120,
            "period": 60,
          },
        },
        {
          "name": "IDENTITY_RATE_LIMITER",
          "namespace_id": "4013",
          "simple": {
            "limit": 30,
            "period": 60,
          },
        },
      ],
    },
  },
}
